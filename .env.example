# Copy this file to .env and fill in real values. .env is gitignored.

# OpenAI API key — reuse the same key from project-pawsitive-coach.
# Get one at https://platform.openai.com/api-keys if you don't have it handy.
OPENAI_API_KEY=

# Long random string used to sign session cookies + password reset tokens.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=

# Flask debug + run config (override only if you need to)
FLASK_ENV=development
FLASK_DEBUG=1

# --- Phase 7L: maintenance mode ---
# Set to 1 during planned restore/maintenance windows. /healthz and static
# assets stay available; normal app routes return a friendly 503.
# MAINTENANCE_MODE=0
# Optional custom copy for the maintenance page.
# MAINTENANCE_MESSAGE=We are restoring a backup. Please try again in a few minutes.

# --- Phase 3C: AI meal-planning guardrails ---
# OpenAI model used by the /meal-plan route. Default is gpt-4o-mini
# (cheap, JSON-mode capable). Switch to gpt-4o for higher quality at
# ~6x the cost. Read at request time, so changes take effect after
# the next call without a restart.
# MEAL_PLAN_MODEL=gpt-4o-mini

# Per-user-per-day cap on meal-plan calls. Resets at UTC midnight.
# Default is 20. Drop it for tighter cost control; raise it for power
# users. Garbage values (non-numeric, 0, negative) fall back silently
# to the default rather than locking users out.
# MEAL_PLAN_DAILY_LIMIT=20
